  <script>
    const status = document.getElementById("action-status");
    const manualSave = document.getElementById("manual-save");
    const fallbackContent = document.getElementById("fallback-content");
    let currentFilename = "";

    async function copyText(text, filename) {
      try {
        if (!navigator.clipboard || !window.isSecureContext) {
          throw new Error("Clipboard access is unavailable in this browser preview.");
        }
        await navigator.clipboard.writeText(text);
        status.textContent = `${filename} copied in full. Paste it wherever you need it.`;
      } catch (error) {
        const fallback = document.getElementById("fallback-content");
        document.getElementById("manual-save-name").textContent = `File name: ${filename}`;
        fallback.value = text;
        manualSave.classList.remove("hidden");
        fallback.focus();
        fallback.select();
        status.textContent = `Clipboard was blocked. The full ${filename} text is selected below for manual copying.`;
      }
    }

    document.querySelectorAll("[data-copy]").forEach((button) => {
      button.addEventListener("click", () => {
        const field = document.getElementById(button.dataset.copy);
        copyText(field.value, button.dataset.copy === "skill-content" ? "skill.md" : "llm.txt");
      });
    });

    document.querySelectorAll("[data-save]").forEach((button) => {
      button.addEventListener("click", () => {
        const field = document.getElementById(button.dataset.save);
        const filename = button.dataset.filename;
        const text = `${field.value.trim()}\n`;
        currentFilename = filename;
        fallbackContent.value = text;
        document.getElementById("manual-save-name").textContent = `File name: ${filename}`;
        manualSave.classList.remove("hidden");

        try {
          const blob = new Blob([text], {
            type: "text/plain;charset=utf-8"
          });
          const objectUrl = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.href = objectUrl;
          link.download = filename;
          link.style.display = "none";
          document.body.appendChild(link);
          link.click();
          link.remove();
          window.setTimeout(() => URL.revokeObjectURL(objectUrl), 30000);
          status.textContent = `Asked the browser to save ${filename}. If no file appeared, use the manual-copy box below.`;
        } catch (error) {
          status.textContent = `The browser blocked saving ${filename}. Use the manual-copy box below; the complete file is ready there.`;
          fallbackContent.focus();
          fallbackContent.select();
        }
      });
    });

    document.getElementById("copy-fallback").addEventListener("click", () => {
      copyText(fallbackContent.value, currentFilename || "the selected guide");
    });

    const searchField = document.getElementById("skill-search");
    const skillCards = [...document.querySelectorAll(".skill-card")];
    const resultsStatus = document.getElementById("results-status");
    const emptyState = document.getElementById("empty-state");

    searchField.addEventListener("input", () => {
      const query = searchField.value.trim().toLowerCase();
      let visibleCount = 0;
      skillCards.forEach((card) => {
        const matches = !query || `${card.textContent} ${card.dataset.search}`.toLowerCase().includes(query);
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      });
      resultsStatus.textContent = query ?
        `${visibleCount} skill${visibleCount === 1 ? "" : "s"} match “${searchField.value.trim()}”.` :
        "Showing all skills.";
      emptyState.classList.toggle("hidden", visibleCount > 0);
    });

  </script>
