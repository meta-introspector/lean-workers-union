<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Keep ZIP and tar.gz archives locally, inspect and filter files, make LLM-ready summaries, and share only selected files using file-type profiles.">
  <title>Private archives & file profiles — Lodge House</title>
  <link rel="stylesheet" href="/theme.css">
  <script>
    try {
      if (localStorage.getItem("lodge-high-contrast") === "on") {
        document.documentElement.dataset.contrast = "high";
      }
    } catch (error) {
      // Browser storage may be unavailable.
    }
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/fflate/umd/index.js"></script>
  <style>
    .file-row[hidden] {
      display: none;
    }

    .drop-zone {
      border: 2px dashed var(--color-line-strong);
    }

    .drop-zone.is-over {
      border-color: var(--color-primary);
      background: var(--color-overlay-soft);
    }

